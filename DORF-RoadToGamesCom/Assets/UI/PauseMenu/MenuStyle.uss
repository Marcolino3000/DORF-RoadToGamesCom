:root {
}

Label {
    -unity-font-definition: url("project://database/Assets/Fonts/Fancy-Regular.otf?fileID=12800000&guid=37567676b964d4408b499bb1e061114a&type=3#Fancy-Regular");
    font-size: 36px;
    -unity-font-style: normal;
    -unity-text-align: upper-center;
    color: rgb(255, 255, 255);
}

/* The settings menu's subtitle switch. The Label rule above sizes its text to 36px, but the
   checkmark box keeps the default 18px, which is close to invisible on the exhibition screen. */
Toggle .unity-toggle__checkmark {
    width: 36px;
    height: 36px;
    margin-left: 8px;
}
