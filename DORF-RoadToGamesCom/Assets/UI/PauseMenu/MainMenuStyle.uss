:root {
}

.button {
    width: 250px;
    height: 80px;
    align-self: center;
    margin-top: -10px;
    margin-right: 0;
    margin-bottom: -10px;
    margin-left: 0;
    align-content: flex-end;
    justify-content: flex-end;
    background-image: none;
    background-color: rgba(255, 255, 255, 0);
    flex-shrink: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.startButton {
    background-image: url("project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v02_Start_Button_lay01.png?fileID=2800000&guid=604767b36116a4ecba92c012a80a6799&type=3#UI_Main_Menu_abs_v02_Start_Button_lay01");
}

.startButton:hover {
    background-image: url("project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v02_Start_Button_lay02_glow.png?fileID=2800000&guid=299e866b9fba94074a87a877bfa648c5&type=3#UI_Main_Menu_abs_v02_Start_Button_lay02_glow");
    scale: 1.02 1.02;
}

.resumeButton {
    background-image: url("project://database/Assets/UI/PauseMenu/Menu%20Sprites/UI_Main_Menu_abs_v02_Fortsetzen_Button_lay01.png?fileID=2800000&guid=57f26e8c1684740a784d6b87eb4bf0b8&type=3#UI_Main_Menu_abs_v02_Fortsetzen_Button_lay01");
