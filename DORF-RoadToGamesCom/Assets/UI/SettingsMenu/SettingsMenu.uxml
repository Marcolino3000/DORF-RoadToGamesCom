<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PauseMenu/MenuStyle.uss?fileID=7433441132597879392&amp;guid=a747a1371a8ed494dbebb750309ee9f3&amp;type=3#MenuStyle" />
    <ui:VisualElement name="background" style="flex-grow: 1; background-color: rgb(0, 0, 0);">
        <ui:Label text="Sound Settings" name="soundSettings" style="-unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/Visuals/Fonts/Fancy-Regular.otf?fileID=12800000&amp;guid=37567676b964d4408b499bb1e061114a&amp;type=3#Fancy-Regular&quot;); -unity-font-style: bold; font-size: 58px;" />
        <ui:VisualElement name="container" style="flex-grow: 1; margin-top: 50px; margin-right: 650px; margin-bottom: 0; margin-left: 550px;">
            <ui:Slider label="Master" name="masterVolume" high-value="1" value="100" />
            <ui:Slider label="Dialog" value="1" high-value="1" name="dialogVolume" />
            <ui:Slider label="Music" value="100" high-value="1" name="musicVolume" />
            <ui:Slider label="SFX" value="100" high-value="1" name="sfxVolume" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
