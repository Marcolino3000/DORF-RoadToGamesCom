/* Smartphone — dark-mode tokens and shared classes.
   Icons are intentionally untinted; PNG sources provide the colour. */

/* ---------- Phone screen ---------- */
.phone-screen {
    background-color: rgb(0, 0, 0);
    -unity-font-definition: url("project://database/Assets/Fonts/Fancy-Regular.otf?fileID=12800000&guid=37567676b964d4408b499bb1e061114a&type=3#Fancy-Regular");
}

/* ---------- Status bar ---------- */
.status-bar {
    flex-direction: row;
    align-items: center;
    height: 50px;
    padding-left: 15px;
    padding-right: 15px;
    flex-shrink: 0;
}

.status-bar__group {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.status-bar__group--right {
    justify-content: flex-end;
}

.status-bar__text {
    font-size: 22px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
}

.status-bar__time {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 30px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

/* ---------- Headline / search ---------- */
.headline {
    font-size: 45px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
    align-self: flex-start;
}

.search-bar {
    margin-top: 5px;
    height: 42px;
    background-color: rgb(44, 44, 46);
    border-top-left-radius: 21px;
    border-top-right-radius: 21px;
    border-bottom-left-radius: 21px;
    border-bottom-right-radius: 21px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
}

.search-bar__placeholder {
    font-size: 22px;
    color: rgb(142, 142, 147);
    margin-left: 5px;
    letter-spacing: 1px;
}

/* ---------- Divider ---------- */
.divider {
    height: 1px;
    background-color: rgb(56, 56, 58);
    flex-shrink: 0;
}

/* ---------- Nav bar ---------- */
.nav-bar {
    flex-direction: row;
    height: 80px;
    background-color: rgb(28, 28, 30);
    border-top-width: 1px;
    border-top-color: rgb(56, 56, 58);
    flex-shrink: 0;
}

.nav-bar__item {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    justify-content: center;
}

.nav-bar__label {
    font-size: 14px;
    color: rgb(199, 199, 204);
    -unity-font-style: bold;
    margin-top: 5px;
    letter-spacing: 1px;
}

.nav-bar__profile-circle {
    width: 35px;
    height: 35px;
    background-color: rgb(72, 72, 74);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

/* ---------- Chat card ---------- */
.chat-card {
    flex-direction: row;
    align-items: center;
    padding-top: 12px;
    padding-right: 18px;
    padding-bottom: 12px;
    padding-left: 18px;
    height: 80px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(56, 56, 58);
}

.avatar {
    width: 55px;
    height: 55px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
    background-color: rgb(72, 72, 74);
    flex-shrink: 0;
}

.chat-card__center {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    margin-left: 15px;
    min-width: 0;
}

.chat-card__name {
    font-size: 20px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
}

.chat-card__subrow {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.chat-card__status-icon {
    width: 20px;
    height: 12px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 5px;
    display: none;
}

.chat-card__status-icon--sent {
    display: flex;
    background-image: url("project://database/Assets/UI/Smartphone/Status_Sent.png?fileID=2800000&guid=19c3ae65ca38459ea433dedbdce51e56&type=3#Status_Sent");
}

.chat-card__status-icon--delivered {
    display: flex;
    background-image: url("project://database/Assets/UI/Smartphone/Status_Delivered.png?fileID=2800000&guid=828c6ae5feca411b9fc0723367fe808b&type=3#Status_Delivered");
}

.chat-card__status-icon--read {
    display: flex;
    background-image: url("project://database/Assets/UI/Smartphone/Status_Read.png?fileID=2800000&guid=b953ed22bf464f33a8d6f1a3dc662cac&type=3#Status_Read");
}

.chat-card__preview {
    font-size: 16px;
    color: rgb(142, 142, 147);
    flex-shrink: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.chat-card__right {
    flex-direction: column;
    align-items: flex-end;
    align-self: stretch;
    justify-content: space-between;
    flex-shrink: 0;
    margin-left: 10px;
}

.chat-card__time {
    font-size: 17px;
    color: rgb(142, 142, 147);
    margin-right: 0;
}

/* ---------- Badge ---------- */
.badge {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgb(245, 245, 247);
    align-items: center;
    justify-content: center;
}

.badge__text {
    flex-grow: 1;
    align-self: stretch;
    font-size: 20px;
    color: rgb(25, 25, 30);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

/* ---------- Chat view (conversation page) ---------- */
.chat-view__header {
    flex-direction: row;
    align-items: center;
    height: 70px;
    padding-left: 8px;
    padding-right: 20px;
    flex-shrink: 0;
}

.chat-view__back {
    width: 20px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Smartphone/ChevronLeft.png?fileID=2800000&guid=52c300eadbc7af9b61afb8338a938294&type=3#ChevronLeft");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(245, 245, 247);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 12px;
    margin-bottom: 0;
    margin-left: 0px;
}

.chat-view__back:hover {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(199, 199, 204);
}

.chat-view__avatar {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-color: rgb(72, 72, 74);
    flex-shrink: 0;
    margin-right: 12px;
}

.chat-view__name {
    font-size: 22px;
    color: rgb(245, 245, 247);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ---------- Message bubble ---------- */
.message-row {
    flex-direction: column;
    align-items: flex-start;
    padding-top: 5px;
    padding-right: 12px;
    padding-left: 12px;
}

.message-row--sent {
    align-items: flex-end;
}

.message-bubble {
    max-width: 75%;
    padding-top: 4px;
    padding-right: 10px;
    padding-bottom: 4px;
    padding-left: 10px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-color: rgb(44, 44, 46);
}

.message-bubble__text {
    font-size: 26px;
    color: rgb(245, 245, 247);
    white-space: normal;
    letter-spacing: 1px;
}

.message-row__meta {
    flex-direction: row;
    align-items: center;
    margin-left: 4px;
}

.message-row--sent .message-row__meta {
    margin-left: 0;
    margin-right: 4px;
}

.message-row__time {
    font-size: 14px;
    color: rgb(142, 142, 147);
    letter-spacing: 1px;
}

.message-row__status {
    width: 14px;
    height: 9px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    display: none;
}

.message-row__status--sent {
    display: flex;
    background-image: url("project://database/Assets/UI/Smartphone/Status_Sent.png?fileID=2800000&guid=19c3ae65ca38459ea433dedbdce51e56&type=3#Status_Sent");
}

.message-row__status--delivered {
    display: flex;
    background-image: url("project://database/Assets/UI/Smartphone/Status_Delivered.png?fileID=2800000&guid=828c6ae5feca411b9fc0723367fe808b&type=3#Status_Delivered");
}

.message-row__status--read {
    display: flex;
    background-image: url("project://database/Assets/UI/Smartphone/Status_Read.png?fileID=2800000&guid=b953ed22bf464f33a8d6f1a3dc662cac&type=3#Status_Read");
}

/* ---------- Voice memo bubble ---------- */
.voice-memo {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 4px;
    padding-right: 4px;
    min-width: 280px;
}

.voice-memo__play {
    width: 18px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Smartphone/PlayIcon.png?fileID=2800000&guid=ef097f28014a9e615101563a4308e140&type=3#PlayIcon");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(245, 245, 247);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    flex-shrink: 0;
}

.voice-memo__play--playing {
    background-image: url("project://database/Assets/UI/Smartphone/PauseIcon.png?fileID=2800000&guid=48a1d89dda5cd26e3685d56afa8b0966&type=3#PauseIcon");
}

.voice-memo__bars {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 28px;
    margin-left: 14px;
    margin-right: 14px;
}

.voice-memo__bar {
    width: 3px;
    background-color: rgb(199, 199, 204);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
    margin-right: 2px;
}

.voice-memo__avatar {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-color: rgb(72, 72, 74);
    flex-shrink: 0;
    align-items: flex-start;
    justify-content: flex-end;
}

.voice-memo__mic {
    width: 18px;
    height: 18px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/UI/Smartphone/MicIcon.png?fileID=2800000&guid=c1f658b48e1f4df3bc8d9110d54cdb51&type=3#MicIcon");
    -unity-background-scale-mode: scale-to-fit;
    margin-left: -2px;
    margin-bottom: -2px;
}

/* ---------- Message input bar (shown in place of the nav bar inside a chat) ---------- */
.input-bar {
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(28, 28, 30);
    border-top-width: 1px;
    border-top-color: rgb(56, 56, 58);
    flex-shrink: 0;
}

.input-bar__plus {
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-right: 8px;
}

.input-bar__field {
    flex-grow: 1;
    height: 42px;
    background-color: rgb(44, 44, 46);
    border-radius: 21px;
    margin-right: 10px;
}

.input-bar__icon {
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
    margin-left: 6px;
}

/* ---------- Date separator (shown when a message starts a new day) ---------- */
.row-wrapper {
    flex-direction: column;
}

.date-separator {
    align-self: center;
    background-color: rgb(44, 44, 46);
    color: rgb(199, 199, 204);
    -unity-text-align: middle-center;
    font-size: 14px;
    letter-spacing: 1px;
    height: 20px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    margin-top: 12px;
    margin-bottom: 6px;
}

/* ---------- No hover / selection highlight on messages ---------- */
/* The runtime theme tints ListView items on pointer hover and selection,
   even when selection-type=None. Override for the conversation list only. */
#messagesListView .unity-collection-view__item:hover,
#messagesListView .unity-collection-view__item--selected,
#messagesListView .unity-collection-view__item:checked,
#messagesListView .unity-collection-view__item:focus {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/* ---------- Chat list hover highlight ---------- */
/* Subtle elevated tint on hover. Matches the nav-bar / search-bar surfaces
   so it reads as a known dark-mode "lifted" colour. Preview text
   (#8E8E93) on this background still passes WCAG AA, and the white
   contact name + colourful badge stay prominent. */
#chatListView .unity-collection-view__item:hover {
    background-color: rgb(28, 28, 30);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

#chatListView .unity-collection-view__item--selected,
#chatListView .unity-collection-view__item:checked,
#chatListView .unity-collection-view__item:focus {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/* ---------- Slim scrollbar (chat list & messages list) ---------- */
/* Hide the up/down arrow buttons so the scroller is just the dragger. */
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

/* Narrow vertical scroller column. */
.unity-scroller--vertical {
    width: 10px;
    margin-left: 0;
    margin-right: 2px;
}

/* Hide the track — only the dragger should be visible. */
.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

/* Slim, rounded dragger. */
.unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    background-color: rgba(142, 142, 147, 0.5);
    border-radius: 3px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-left: 0;
    margin-right: 0;
}
