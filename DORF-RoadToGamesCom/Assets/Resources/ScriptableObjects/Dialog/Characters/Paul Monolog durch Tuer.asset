  m_Script: {fileID: 11500000, guid: 2818dd0c5b404dfe8aedaf83b49ab7b1, type: 3}
  m_Name: "\xC4hh... Marlene? ..."
  m_EditorClassIdentifier: cod.dialogbuilder::Nodes.Decorator.NpcDialogOption
  Guid: 774406e73294345cc9d8a7e5b4a2bd61
  Position: {x: 951, y: 522}
  customPreview: 0
  Blackboard:
    CharacterData: {fileID: 11400000, guid: 67e6c4e2e200e4e43a4811bd56319965, type: 2}
  DialogLine: "\xC4hh... Marlene? Jaa lass uns einfach wann anders nochmal quatschen
    kein Problem.\nVielleicht h\xE4tte ich das mit der Bettina nicht sagen sollen.
    Hat ja eh gerade genug Probleme gerade. \nVielleicht h\xE4tte ich ihr sagen sollen
    wer bei der Hochzeit singt. Ich mein zu Bodo Bieramoschd hat ja noch kein nein
    gesagt.\n"
  DialogLineEn: "Uhh... Marlene? Yeah, let's just chat some other time, no problem.\nMaybe I shouldn't have said that about Bettina. She's got enough problems right now anyway. \nMaybe I should have told her who's singing at the wedding. I mean, nobody has ever said no to Bodo Bieramoschd.\n"
  TextPreview: "\xC4hh... Marlene? ..."
  AudioClip: {fileID: 8300000, guid: 14551678a11cc4ee78912e5f4cbd7a02, type: 3}
