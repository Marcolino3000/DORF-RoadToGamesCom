  Position: {x: -150.00005, y: 993.05536}
  customPreview: 0
  Blackboard:
    CharacterData: {fileID: 11400000, guid: 62b539070ac644f6eb8e8be906c4d929, type: 2}
  DialogLine: "Also wie gesagt: Du f\xFCtterst ihn jeden Tag. Achte einfach darauf,
    dass es dem Sauerteig nicht zu warm und nicht zu kalt ist.\n Du hast wahrscheinlich
    noch nie vorher einen Sauerteig angesetzt, oder?\nAlso, von den Sauerteigen ist
    das Gute \u2013 der ist ja schon angesetzt. Du musst nur gut aufpassen, dass
    er nicht eingeht.\nUnd wenn du Fragen hast, kannst du mich jederzeit fragen.
    Hab ich noch etwas vergessen?\nSoll ich es dir lieber aufschreiben? Du musst
    dich um ihn k\xFCmmern wie um so ein \u2026 wie hei\xDFen die noch? Tamagotchi?"
  TextPreview: Also wie gesagt:...
  AudioClip: {fileID: 8300000, guid: de78c991ebadf49cabefb225fd82d1dd, type: 3}
